# Copy to .env (never commit .env). Values here are placeholders only.

# --- Local self-hosted NIM (local mode) ---
# Verified path: POST {base}/v1/audio/transcriptions on the NIM HTTP port (9000 by default).
LOCAL_NIM_BASE_URL=http://127.0.0.1:9000

# --- NVIDIA cloud (cloud mode): gRPC, Riva protocol, TLS ---
# Master switch. Default false. An API key alone does NOT enable cloud transcription.
# Cloud jobs also require a per-job consent checkbox in the UI.
ENABLE_NVIDIA_CLOUD=false
# Official zh-TW function: https://build.nvidia.com/nvidia/parakeet-ctc-0_6b-zh-tw/api
# Cloud mode stays disabled until NVIDIA_API_KEY is set. Do NOT commit this file with a real key.
NVIDIA_GRPC_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_GRPC_FUNCTION_ID=8473f56d-51ef-473c-bb26-efd4f5def2bf
NVIDIA_API_KEY=

# --- FFmpeg ---
# Bare names use PATH. Relative paths are resolved from the project root.
# Portable build used by this project: tools/ffmpeg/bin (not committed).
FFMPEG_PATH=tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=tools/ffmpeg/bin/ffprobe.exe

# --- Limits ---
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=14400
NIM_CHUNK_SECONDS=60
JOB_TIMEOUT_SECONDS=3600
NIM_REQUEST_TIMEOUT_SECONDS=300
NIM_MAX_RETRIES=2
NIM_RETRY_BACKOFF_SECONDS=2
